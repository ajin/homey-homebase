{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.rxd7.homebase",
  "version": "0.2.0",
  "compatibility": ">=12.0.0",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "brandColor": "#4F46E5",
  "name": {
    "en": "Homebase"
  },
  "description": {
    "en": "Control your devices locally from Homey, without the cloud."
  },
  "category": [
    "lights"
  ],
  "tags": {
    "en": [
      "local",
      "surplife",
      "zengge",
      "quntis",
      "ble",
      "bluetooth",
      "christmas lights",
      "led",
      "hamulight",
      "433 MHz",
      "veranda"
    ]
  },
  "permissions": [
    "homey:wireless:ble",
    "homey:wireless:433"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "rxd7"
  },
  "api": {
    "scan": {
      "method": "GET",
      "path": "/diagnostics/scan"
    },
    "listDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "listEffects": {
      "method": "GET",
      "path": "/effects"
    },
    "saveEffect": {
      "method": "POST",
      "path": "/effects"
    },
    "deleteEffect": {
      "method": "DELETE",
      "path": "/effects/:id"
    },
    "play": {
      "method": "POST",
      "path": "/play"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "hamulight_remote_pressed",
        "title": {
          "en": "On/off button on the handheld remote was pressed"
        },
        "hint": {
          "en": "Needs 'Follow the handheld remote' in the device settings, and Homey must be in range of the remote."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hamulight-433-light"
          }
        ]
      },
      {
        "id": "effect_changed",
        "title": {
          "en": "Effect changed"
        },
        "hint": {
          "en": "Also fires when the effect is changed with the handheld remote or the phone app (while Homey is connected)."
        },
        "tokens": [
          {
            "name": "effect",
            "type": "number",
            "title": {
              "en": "Pattern number (0 = static colour)"
            },
            "example": 5
          },
          {
            "name": "name",
            "type": "string",
            "title": {
              "en": "Effect name"
            },
            "example": "Christmas 1"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          }
        ]
      },
      {
        "id": "connection_lost",
        "title": {
          "en": "Bluetooth connection was lost unexpectedly"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          }
        ]
      },
      {
        "id": "connection_restored",
        "title": {
          "en": "Bluetooth connection was restored"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          }
        ]
      },
      {
        "id": "notification_received",
        "title": {
          "en": "Controller sent a message"
        },
        "hint": {
          "en": "Diagnostic: fires for every decoded notification from the controller."
        },
        "tokens": [
          {
            "name": "opcode",
            "type": "number",
            "title": {
              "en": "Opcode"
            },
            "example": 22
          },
          {
            "name": "hex",
            "type": "string",
            "title": {
              "en": "Payload (hex)"
            },
            "example": "8133..."
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "hamulight_toggle",
        "title": {
          "en": "Press the on/off button"
        },
        "hint": {
          "en": "Sends the on/off code whatever Homey thinks the light is doing, and flips the state in Homey."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hamulight-433-light"
          }
        ]
      },
      {
        "id": "hamulight_set_state",
        "title": {
          "en": "Mark as [[state]] without sending"
        },
        "titleFormatted": {
          "en": "Mark as [[state]] without sending"
        },
        "hint": {
          "en": "Corrects Homey's on/off state when it got out of step with the light. Nothing is sent."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hamulight-433-light"
          },
          {
            "name": "state",
            "type": "dropdown",
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "hamulight_send_code",
        "title": {
          "en": "Send 433 MHz code"
        },
        "titleFormatted": {
          "en": "Send 433 MHz code [[code]]"
        },
        "hint": {
          "en": "For testing: sends a 32-bit Hamulight code given as 8 hex digits (shown in the app log when the remote is used)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hamulight-433-light"
          },
          {
            "name": "code",
            "type": "text",
            "placeholder": {
              "en": "351BA045"
            }
          }
        ]
      },
      {
        "id": "run_named_effect",
        "title": {
          "en": "Run effect"
        },
        "titleFormatted": {
          "en": "Run effect [[effect]] at speed [[speed]]%"
        },
        "hint": {
          "en": "Any effect from the library: named effects, the controller's patterns and your own effects from the app settings."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          },
          {
            "name": "effect",
            "type": "autocomplete",
            "placeholder": {
              "en": "Search effects"
            }
          },
          {
            "name": "speed",
            "type": "range",
            "min": 1,
            "max": 100,
            "step": 1,
            "value": 80,
            "labelDecimals": 0
          }
        ]
      },
      {
        "id": "run_effect",
        "title": {
          "en": "Run built-in effect"
        },
        "titleFormatted": {
          "en": "Run built-in effect [[effect]] at speed [[speed]]%"
        },
        "hint": {
          "en": "The controller's own effects, the same ones the handheld remote cycles through: 1-11, 13-22 and 25-37."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          },
          {
            "name": "effect",
            "type": "number",
            "min": 1,
            "max": 37,
            "step": 1,
            "placeholder": {
              "en": "1-37"
            }
          },
          {
            "name": "speed",
            "type": "range",
            "min": 1,
            "max": 100,
            "step": 1,
            "value": 50,
            "labelDecimals": 0
          }
        ]
      },
      {
        "id": "query_state",
        "title": {
          "en": "Ask the controller for its state"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          }
        ]
      },
      {
        "id": "unpair_remotes",
        "title": {
          "en": "Unpair all remotes"
        },
        "hint": {
          "en": "Removes every Bluetooth (radio) remote paired with this light. Infrared remotes are not affected."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          }
        ]
      },
      {
        "id": "send_raw",
        "title": {
          "en": "Send raw command (advanced)"
        },
        "titleFormatted": {
          "en": "Send opcode [[opcode]] payload [[hex]] [[checksum]]"
        },
        "hint": {
          "en": "Diagnostic: sends an arbitrary payload through the Zengge transport. Use only for reverse-engineering."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          },
          {
            "name": "opcode",
            "type": "number",
            "min": 0,
            "max": 255,
            "step": 1,
            "placeholder": {
              "en": "11"
            }
          },
          {
            "name": "hex",
            "type": "text",
            "placeholder": {
              "en": "3b 23 00 00 00 00 00 00 00 00 00 00"
            }
          },
          {
            "name": "checksum",
            "type": "dropdown",
            "values": [
              {
                "id": "append",
                "label": {
                  "en": "and append checksum"
                }
              },
              {
                "id": "none",
                "label": {
                  "en": "as-is"
                }
              }
            ]
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_connected",
        "title": {
          "en": "Bluetooth link !{{is|is not}} open"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zengge-ble-light"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Hamulight Light (433 MHz)"
      },
      "class": "light",
      "capabilities": [
        "onoff",
        "dim"
      ],
      "capabilitiesOptions": {
        "dim": {
          "opts": {
            "duration": false
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "rf433"
      ],
      "rf433": {
        "satelliteMode": true
      },
      "images": {
        "small": "/drivers/hamulight-433-light/assets/images/small.png",
        "large": "/drivers/hamulight-433-light/assets/images/large.png",
        "xlarge": "/drivers/hamulight-433-light/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "learn"
        }
      ],
      "repair": [
        {
          "id": "learn"
        }
      ],
      "id": "hamulight-433-light",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Learned remote"
          },
          "children": [
            {
              "id": "info_remote",
              "type": "label",
              "label": {
                "en": "Remote id / on-off code"
              },
              "value": "-",
              "hint": {
                "en": "Learned when the light was added. Use 'Repair' on the device to teach the remote again."
              }
            },
            {
              "id": "info_levels",
              "type": "label",
              "label": {
                "en": "Learned brightness levels"
              },
              "value": "0"
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Radio"
          },
          "children": [
            {
              "id": "dim_source",
              "type": "dropdown",
              "label": {
                "en": "Brightness codes"
              },
              "value": "ring",
              "hint": {
                "en": "'Ring position' builds the code for a position on the remote's brightness ring (HM3002 and similar remotes). 'Learned' replays codes captured from the ring during pairing. 'Calculated' uses the published encoding of another Hamulight remote."
              },
              "values": [
                {
                  "id": "ring",
                  "label": {
                    "en": "Ring position"
                  }
                },
                {
                  "id": "learned",
                  "label": {
                    "en": "Learned from my remote"
                  }
                },
                {
                  "id": "generated",
                  "label": {
                    "en": "Calculated (experimental)"
                  }
                }
              ]
            },
            {
              "id": "repetitions",
              "type": "number",
              "label": {
                "en": "Frames per command"
              },
              "value": 3,
              "min": 1,
              "max": 3,
              "hint": {
                "en": "Frames sent back to back in one transmission (Homey allows at most 3). Repeating the transmission made the light sometimes see two presses."
              }
            },
            {
              "id": "on_brightness",
              "type": "checkbox",
              "label": {
                "en": "Send brightness after switching on"
              },
              "value": false,
              "hint": {
                "en": "Sends the last brightness right after the on command, for lights that come on at a different level."
              }
            },
            {
              "id": "follow_remote",
              "type": "checkbox",
              "label": {
                "en": "Follow the handheld remote"
              },
              "value": true,
              "hint": {
                "en": "Updates on/off and brightness in Homey when the handheld remote is used near Homey. Turn off to save Homey resources."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Brightness ring"
          },
          "children": [
            {
              "id": "ring_dark",
              "type": "text",
              "label": {
                "en": "Darkest position (hex)"
              },
              "value": "55",
              "hint": {
                "en": "Ring position (00-7F) Homey sends for the lowest brightness. Used with 'Ring position'."
              }
            },
            {
              "id": "ring_bright",
              "type": "text",
              "label": {
                "en": "Brightest position (hex)"
              },
              "value": "5F",
              "hint": {
                "en": "Ring position (00-7F) Homey sends for full brightness."
              }
            },
            {
              "id": "ring_direction",
              "type": "dropdown",
              "label": {
                "en": "Direction from darkest to brightest"
              },
              "value": "down",
              "values": [
                {
                  "id": "down",
                  "label": {
                    "en": "Counting down (55, 54, … 00, 7F, … 5F)"
                  }
                },
                {
                  "id": "up",
                  "label": {
                    "en": "Counting up"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": {
        "en": "Surplife Bluetooth Light"
      },
      "class": "light",
      "capabilities": [
        "onoff",
        "dim",
        "light_hue",
        "light_saturation",
        "light_temperature",
        "light_mode",
        "lighting_effect",
        "lighting_effect_speed"
      ],
      "capabilitiesOptions": {
        "dim": {
          "opts": {
            "duration": false
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "ble"
      ],
      "images": {
        "small": "/drivers/zengge-ble-light/assets/images/small.png",
        "large": "/drivers/zengge-ble-light/assets/images/large.png",
        "xlarge": "/drivers/zengge-ble-light/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "zengge-ble-light",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection"
          },
          "children": [
            {
              "id": "command_profile",
              "type": "dropdown",
              "value": "auto",
              "label": {
                "en": "Command set"
              },
              "hint": {
                "en": "Which Zengge command family to send. 'Automatic' picks one from the product id the controller advertises. Change this only if the lights do not react."
              },
              "values": [
                {
                  "id": "auto",
                  "label": {
                    "en": "Automatic (from product id)"
                  }
                },
                {
                  "id": "zengge_v2_e1",
                  "label": {
                    "en": "Zengge unified + symphony effects (0x3B / E1 21)"
                  }
                },
                {
                  "id": "zengge_v2",
                  "label": {
                    "en": "Zengge unified (0x3B)"
                  }
                },
                {
                  "id": "symphony_v3",
                  "label": {
                    "en": "Symphony v3 (0xE0)"
                  }
                },
                {
                  "id": "zengge_legacy",
                  "label": {
                    "en": "Zengge legacy (0x71 / 0x31)"
                  }
                }
              ]
            },
            {
              "id": "max_packet",
              "type": "dropdown",
              "value": "255",
              "label": {
                "en": "Maximum BLE packet size"
              },
              "hint": {
                "en": "255 matches the Surplife app. Choose 20 if commands are ignored; longer commands are then split into protocol segments."
              },
              "values": [
                {
                  "id": "255",
                  "label": {
                    "en": "255 bytes (app default)"
                  }
                },
                {
                  "id": "20",
                  "label": {
                    "en": "20 bytes (minimum MTU)"
                  }
                }
              ]
            },
            {
              "id": "idle_disconnect",
              "type": "number",
              "value": 120,
              "min": 0,
              "max": 3600,
              "units": {
                "en": "s"
              },
              "label": {
                "en": "Disconnect after idle"
              },
              "hint": {
                "en": "Release the Bluetooth link after this many seconds without commands, so the Surplife phone app can still connect. 0 keeps the link open."
              }
            },
            {
              "id": "min_write_gap",
              "type": "number",
              "value": 60,
              "min": 20,
              "max": 1000,
              "units": {
                "en": "ms"
              },
              "label": {
                "en": "Minimum gap between writes"
              }
            },
            {
              "id": "colour_correction",
              "type": "checkbox",
              "value": true,
              "label": {
                "en": "Colour correction"
              },
              "hint": {
                "en": "Compensates for the strong green LEDs so orange and yellow look right. Calibrated on the Quntis 204-LED string. Turn off to send standard colour-wheel hues."
              }
            },
            {
              "id": "brightness_curve",
              "type": "dropdown",
              "value": "perceptual",
              "label": {
                "en": "Brightness curve"
              },
              "hint": {
                "en": "Perceptual makes each step of the dim slider look like an even step (50 % looks half as bright). Linear sends the slider value to the controller as is."
              },
              "values": [
                {
                  "id": "perceptual",
                  "label": {
                    "en": "Perceptual"
                  }
                },
                {
                  "id": "linear",
                  "label": {
                    "en": "Linear"
                  }
                }
              ]
            },
            {
              "id": "restore_on_reconnect",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "Restore last state after an unexpected reconnect"
              }
            },
            {
              "id": "debug_logging",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "Diagnostic logging"
              },
              "hint": {
                "en": "Log every frame written and received (hex) to the app log."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Remote controls"
          },
          "children": [
            {
              "id": "remote_control",
              "type": "dropdown",
              "value": "open",
              "label": {
                "en": "Remotes that can control this light"
              },
              "hint": {
                "en": "Same as the Surplife app's Remote Control Settings, stored in the light itself. Covers Bluetooth (radio) remotes and control panels only: infrared remotes and phones are not affected. When the light is removed from Homey, this is set back to 'All remotes' and paired remotes are unpaired."
              },
              "values": [
                {
                  "id": "open",
                  "label": {
                    "en": "All remotes (factory setting)"
                  }
                },
                {
                  "id": "paired_only",
                  "label": {
                    "en": "Only remotes paired with this light"
                  }
                },
                {
                  "id": "disabled",
                  "label": {
                    "en": "No remotes"
                  }
                }
              ]
            },
            {
              "id": "info_remotes",
              "type": "label",
              "value": "",
              "label": {
                "en": "Paired remotes"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Controller information (read-only)"
          },
          "children": [
            {
              "id": "info_mac",
              "type": "label",
              "value": "",
              "label": {
                "en": "MAC address"
              }
            },
            {
              "id": "info_product",
              "type": "label",
              "value": "",
              "label": {
                "en": "Product id"
              }
            },
            {
              "id": "info_versions",
              "type": "label",
              "value": "",
              "label": {
                "en": "BLE / firmware / LED version"
              }
            },
            {
              "id": "info_profile",
              "type": "label",
              "value": "",
              "label": {
                "en": "Active command set"
              }
            },
            {
              "id": "info_last_state",
              "type": "label",
              "value": "",
              "label": {
                "en": "Last state bytes"
              }
            }
          ]
        }
      ]
    }
  ],
