{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "outDir": ".homeybuild/",
    "rootDir": "."
  },
  "include": ["app.ts", "api.ts", "lib/**/*.ts", "drivers/**/*.ts"]
}
